# ---------------------------------------------------------------------------
# Enterprise Jev — environment variables
# Copy to .env for local dev. On Vercel, set these in Project → Settings →
# Environment Variables (never commit real keys).
# ---------------------------------------------------------------------------

# TypeSafe System One (Jev) — required for full, arbitrary-prompt classification.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenAI — optional. Only used to draft Postgres RLS policy SQL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local HTTP port (ignored on Vercel).
PORT=4731

# Zero-key demo mode: set to 1 to run the canonical showcase prompts
# (Dana, Sarah, superadmin, RLS, etc.) with a local fixture and no external
# API calls. Leave unset when TYPESAFE_API_KEY is provided.
JEV_FIXTURE=
